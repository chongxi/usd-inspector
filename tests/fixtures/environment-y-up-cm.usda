#usda 1.0
(
    defaultPrim = "Office"
    metersPerUnit = 0.01
    upAxis = "Y"
)

def Xform "Office"
{
    def Cube "Floor" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        double size = 2
        double3 xformOp:translate = (0, -5, 0)
        double3 xformOp:scale = (100, 5, 150)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.25, 0.5, 0.2)]
    }
    def Cube "InvisibleCollider"
    {
        token visibility = "invisible"
        double size = 10000
    }
    def Points "SurveyPoint"
    {
        point3f[] points = [(20, -1, 20)]
        float[] widths = [1]
    }
    def Xform "GuideParent"
    {
        uniform token purpose = "guide"
        def Cube "GuideChild" { double size = 20000 }
    }
}
def Cube "OutsideDefaultPrim" { double size = 30000 }
